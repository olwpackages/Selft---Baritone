{
  "schemaVersion": 1,
  "id": "baritone",
  "version": "1.0-SNAPSHOT",
  "name": "Baritone Reborn",
  "description": "A clean, extensible mining bot for Fabric.",
  "authors": ["Baritone Reborn Team"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
